# ---------------------------------------------------------------------------
# PowerSense Pro -- environment variables
# Copy to .env for local dev, or paste into Render -> Environment.
# ---------------------------------------------------------------------------

# --- Supabase (REQUIRED) ---------------------------------------------------
# Project URL from Supabase -> Settings -> API
SUPABASE_URL=https://xxx.supabase.co
# service_role key (NOT the anon key -- this pipeline writes to all tables)
SUPABASE_SERVICE_KEY=eyJ...

# --- Training script only (train_powersense_pytorch.py, upload_models.py) -
# anon/public key for the read-only energy_readings_public table -- NOT the
# service role key above. Reuses SUPABASE_URL from above.
SUPABASE_KEY=your_anon_key_here
# Upload auth for POST /models/upload, if the deployed instance sets one.
UPLOAD_API_KEY=

# --- Device ---------------------------------------------------------------
# Device the scheduler runs the pipeline for
DEVICE_ID=hackathon_machine
MACHINE_NAME=Demo Machine

# --- Twilio WhatsApp alerts (OPTIONAL -- alerts still log to DB without it) -
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# Twilio WhatsApp sandbox sender
TWILIO_FROM_WHATSAPP=whatsapp:+14155238886
ALERT_WHATSAPP_TO=whatsapp:+91XXXXXXXXXX

# --- SendGrid daily email report (OPTIONAL) -------------------------------
SENDGRID_API_KEY=SG...
ALERT_EMAIL_TO=your@email.com
ALERT_EMAIL_FROM=alerts@powersensepro.com

# --- Tuning (OPTIONAL -- defaults shown) ----------------------------------
TARIFF_RATE=9.0
NOMINAL_VOLTAGE=230.0
INDIA_GRID_FACTOR=0.82
RATED_CURRENT=10.0
RATED_POWER=2000.0
CABLE_RESISTANCE=0.5
IDLE_THRESHOLD_PCT=8.0
RATED_PF=0.85
SHIFT_HOURS=8.0

# Alert de-duplication window in seconds (default 30 min)
ALERT_COOLDOWN_SECONDS=1800
# Set to "false" to run the API without the background scheduler
ENABLE_SCHEDULER=true
# Directory for trained model artifacts
MODEL_DIR=./models/trained
